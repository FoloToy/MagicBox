{
    "manufacturer": "folotoy",
    "type": "magicbox-m301-c5-rtc-v1-5g",
    "target": "esp32c5",
    "builds": [
        {
            "name": "folotoy-magicbox-m301-c5-rtc-v1-5g",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_FOLOTOY_MAGICBOX_M301_C5_RTC_V1_5G=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/folotoy-magicbox-m301-c5.csv\"",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_QUAD=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_SPIRAM_MEMTEST=y",
                "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536",
                "CONFIG_FLASH_NONE_ASSETS=y",
                "CONFIG_WAKE_WORD_DISABLED=y",
                "CONFIG_USE_AUDIO_PROCESSOR=n",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_PM_ENABLE=n",
                "CONFIG_I2C_COMMUNICATION_METHOD_BUILTIN_RW=y",
                "CONFIG_SENSORLIB_ESP_IDF_NEW_API=y",
                "CONFIG_XPOWERS_ESP_IDF_NEW_API=y",
                "CONFIG_SENSOR_PMIC_SUPPORT=y",
                "CONFIG_OTA_URL=\"https://magic.folotoy.cn/xiaozhi/ota/\"",
                "CONFIG_WIFI_AP_SSID_PREFIX=\"FoloToy\""
            ]
        }
    ]
}
